# ==========================================================
# AI Business News Assistant - Environment Variables Template
# ==========================================================
# คำแนะนำ: ก๊อปปี้ไฟล์นี้แล้วเปลี่ยนชื่อเป็น .env จากนั้นใส่ API Key ของคุณ
# ข้อควรระวัง: ห้ามอัปโหลดไฟล์ .env ตัวจริงขึ้น GitHub เด็ดขาด!

# 1. LINE Messaging API (สำหรับการตั้งค่า Webhook และส่งข้อความ)
LINE_CHANNEL_ACCESS_TOKEN="your_line_channel_access_token_here"
LINE_CHANNEL_SECRET="your_line_channel_secret_here"

# 2. NewsAPI (สำหรับดึงข่าวเศรษฐกิจและธุรกิจรายวัน)
NEWS_API_KEY="your_newsapi_key_here"

# 3. Pinecone Vector Database (สำหรับระบบความจำ RAG)
PINECONE_API_KEY="your_pinecone_api_key_here"
PINECONE_INDEX_NAME="daily-news-hf"

# 4. Hugging Face (สำหรับทำ Text Embeddings: sentence-transformers/all-MiniLM-L6-v2)
HUGGINGFACE_ACCESS_TOKEN="your_huggingface_token_here"

# 5. Ollama Local LLM (สำหรับการสรุปข่าวและวิเคราะห์ข้อมูล)
OLLAMA_BASE_URL="http://your_ollama_server_ip:11434"
OLLAMA_MODEL="gpt-oss:20b"
